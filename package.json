{
  "name": "logseq-github-theme",
  "version": "2.0.4",
  "description": "😻 GitHub themes for Logseq.",
  "author": "Yue Yang <g1enyy0ung@gmail.com>",
  "repository": "g1eny0ung/logseq-github-theme",
  "scripts": {
    "build": "gulp build",
    "watch": "gulp watch"
  },
  "logseq": {
    "themes": [
      {
        "name": "GitHub Light Default",
        "url": "./dist/light.css",
        "description": "😻 GitHub Light theme for Logseq.",
        "mode": "light"
      },
      {
        "name": "GitHub Dark Default",
        "url": "./dist/dark.css",
        "description": "😻 GitHub Dark theme for Logseq.",
        "mode": "dark"
      },
      {
        "name": "GitHub Dark Dimmed",
        "url": "./dist/dark-dimmed.css",
        "description": "😻 GitHub Dark Dimmed theme for Logseq.",
        "mode": "dark"
      },
      {
        "name": "GitHub Light Default With Dark",
        "url": "./dist/light-dark.css",
        "description": "😻 GitHub Light/Dark theme for Logseq."
      },
      {
        "name": "GitHub Light Default With Dark Dimmed",
        "url": "./dist/light-dark-dimmed.css",
        "description": "😻 GitHub Light/Dark-Dimmed theme for Logseq."
      }
    ],
    "id": "logseq-github-theme"
  },
  "devDependencies": {
    "gulp": "^5.0.1",
    "gulp-sass": "^6.0.1",
    "sass": "^1.97.2"
  }
}
